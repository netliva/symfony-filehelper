{% import '@NetlivaSymfonyFileHelper/macros.html.twig' as mcr %}

{% for files in uploadedFiles %}
	<div class="gallery-item" id="{{options.group~"-"~files.id}}">
		<div class="file_container"
			 data-control="{{ options|is_file_control }}"
			 data-control-type="{{ options|is_file_control ? options.control }}"
		>
            {% set filePath = null %}
            {% if netliva_file_exists(files.path) %}
                {% set fileHref = options.hash is defined and options.hash ? public_media_uri(files.path) : secure_media_uri(files.path) %}
                {% set filePath = options.hash is defined and options.hash 
					? public_media_uri(files.path) 
					: (
						(options.use_image_filter is defined and options.use_image_filter)
						? asset(files.path)|imagine_filter(options.use_image_filter)
						: secure_media_uri(files.path)
					) %}
            {% endif %}

            {% if filePath %}
                <a href="{{ asset(fileHref) }}" target="_blank">
                    <img src="{{ asset(filePath) }}" alt="{{ files.name }}" title="{{ files.name }}">
                </a>
            {% else %}
                <div class="not-found-placeholder">
                    <em class="text-danger" style="font-size: 12px;">Bulunamadı</em>
                </div>
            {% endif %}

			<div class="gallery-item-actions">
				{% if options|is_file_control %}
					{{ mcr.showFileController(files) }}
				{% else %}
					{% if options.upload_btn_in_list|is_true %}
						{{ file_uploader_button(options.group, files.code, null, options|merge({'button_desc': false, 'style': 'icon'})) }}
					{% endif %}
					
					<button
							class="btn btn-xs {{ files.isCover ? 'btn-warning' : 'btn-default' }} netlivaSetCoverBtn"
							data-url="{{ path('netliva_filehelper_set_cover', {"id": files.id}) }}"
							data-refresh='netliva_file_helper.refreshFileSoftLine("{{options.group}}")'
							title="Vitrin Yap"
					><i class="fa-{{ files.isCover ? 'solid' : 'regular' }} fa-star"></i></button>

					{% if options.deletable %}
						<button
								class="btn btn-xs btn-danger netlivaDeleteFile"
								data-delete-url="{{ path('netliva_filehelper_fileDelete', {"id": files.id}) }}"
								data-refresh='$("#{{options.group~"-"~files.id}}").remove()'
                                title="Sil"
						><i class="fa fa-trash"></i></button>
					{% endif %}
				{% endif %}
			</div>
		</div>

		<script type="text/javascript">
			{% if ajaxload is defined %} nfh.resizeNetlivaFileList(); {% endif %}
		</script>
	</div>
{% else %}
    <div class="w-100 text-center text-muted" style="width: 100%; grid-column: 1 / -1; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 150px; background: #fdfdfd; border-radius: 10px; border: 2px dashed #eee;">
        <i class="fa fa-image fa-3x" style="color: #ddd; margin-bottom: 10px;"></i>
        <span>Henüz bu galeriye fotoğraf eklenmedi.</span>
    </div>
{% endfor %}
